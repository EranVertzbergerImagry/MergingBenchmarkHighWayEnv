{
  "description": "test_with_successful_params_from_sicial_attention",
  "train_timesteps": 100000,
  "eval_freq": 5000,
  "eval_episodes": 100,
  "demo_episodes": 10,
  "demo_on_train_end": false,
  "model": {
    "net_arch": [256, 256],
    "learning_rate": 5e-4,
    "n_steps": 256,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 0.95,
    "gae_lambda": 0.95,
    "clip_range": 0.2
  },
  "env": {
    "observation": {
      "type": "Kinematics",
      "vehicles_count": 15,
      "features": ["presence", "x", "y", "vx", "vy", "cos_h", "sin_h"],
      "absolute": true,
      "flatten": true
    },
    "action": {
      "type": "DiscreteMetaAction",
      "target_speeds": [0, 4.5, 9]
    },
    "duration": 13,
    "destination": "o1",
    "initial_vehicle_count": 10,
    "spawn_probability": 0.6,
    "policy_frequency": 5,
    "collision_reward": -5,
    "high_speed_reward": 1,
    "arrived_reward": 1,
    "reward_speed_range": [7.0, 9.0],
    "normalize_reward": false
  },
  "idm": {
    "comfort_acc_max": 3.0,
    "comfort_acc_min": -5.0,
    "distance_wanted": 10.0,
    "time_wanted": 2.5
  }
}
