{
  "description": "default",
  "train_timesteps": 25000,
  "eval_freq": 5000,
  "eval_episodes": 100,
  "demo_episodes": 10,
  "demo_on_train_end": false,
  "model": {
    "net_arch": [256, 256],
    "learning_rate": 3e-4,
    "buffer_size": 15000,
    "learning_starts": 200,
    "batch_size": 256,
    "gamma": 0.8,
    "tau": 0.005,
    "train_freq": 1
  },
  "env": {
    "observation": {
      "type": "Kinematics",
      "vehicles_count": 15,
      "features": ["presence", "x", "y", "vx", "vy", "cos_h", "sin_h"],
      "absolute": true,
      "flatten": true
    },
    "action": {
      "type": "DiscreteMetaAction",
      "target_speeds": [0, 2, 5, 10, 15, 20]
    },
    "max_speed": 10,
    "duration": 100,
    "destination": "o1",
    "initial_vehicle_count": 10,
    "spawn_probability": 0.6,
    "policy_frequency": 5,
    "collision_reward": -20,
    "high_speed_reward": 1,
    "arrived_reward": 20,
    "reward_speed_range": [7.0, 9.0],
    "normalize_reward": false
  },
  "idm": {
    "comfort_acc_max": 3.0,
    "comfort_acc_min": -5.0,
    "distance_wanted": 10.0,
    "time_wanted": 2.5
  }
}
