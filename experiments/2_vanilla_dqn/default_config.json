{
  "description": "default",
  "train_timesteps": 25000,
  "eval_freq": 5000,
  "eval_episodes": 100,
  "demo_episodes": 10,
  "demo_on_train_end": false,
  "env": {
    "observation": {
      "type": "Kinematics",
      "vehicles_count": 15,
      "features": ["presence", "x", "y", "vx", "vy", "cos_h", "sin_h"],
      "absolute": true,
      "flatten": true
    },
    "action": {
      "type": "DiscreteMetaAction",
      "target_speeds": [0, 2, 5, 10, 15, 20]
    },
    "duration": 100,
    "destination": "o1",
    "initial_vehicle_count": 10,
    "spawn_probability": 0.6,
    "policy_frequency": 5,
    "collision_reward": -20,
    "high_speed_reward": 1,
    "arrived_reward": 20,
    "reward_speed_range": [7.0, 9.0],
    "normalize_reward": false
  }
}
