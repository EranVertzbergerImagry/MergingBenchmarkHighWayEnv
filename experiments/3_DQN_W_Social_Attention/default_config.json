{
  "description": "default",
  "train_timesteps": 100000,
  "eval_freq": 5000,
  "eval_episodes": 20,
  "demo_episodes": 3,
  "demo_on_train_end": true,
  "env": {
    "observation": {
      "type": "Kinematics",
      "vehicles_count": 15,
      "features": ["presence", "x", "y", "vx", "vy", "cos_h", "sin_h"],
      "features_range": {"x": [-100, 100], "y": [-100, 100],
                          "vx": [-20, 20], "vy": [-20, 20]},
      "absolute": true,
      "flatten": false,
      "order": "shuffled"
    },
    "action": {
      "type": "DiscreteMetaAction",
      "target_speeds": [0, 2, 5, 10, 15, 20]
    },
    "duration": 100,
    "destination": "o1",
    "initial_vehicle_count": 10,
    "spawn_probability": 0.6,
    "policy_frequency": 5,
    "collision_reward": -5,
    "high_speed_reward": 1,
    "arrived_reward": 1,
    "reward_speed_range": [7.0, 9.0],
    "normalize_reward": false
  }
}
