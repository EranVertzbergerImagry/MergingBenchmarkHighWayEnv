{
  "eval_episodes": 100,
  "demo_episodes": 10,
  "env": {
    "observation": {
      "type": "Kinematics",
      "vehicles_count": 15,
      "features": ["presence", "x", "y", "vx", "vy", "cos_h", "sin_h"],
      "absolute": true,
      "flatten": true
    },
    "action": {
      "type": "DiscreteMetaAction",
      "target_speeds": [0, 2, 5, 10, 15, 20]
    },
    "duration": 100,
    "destination": "o1",
    "initial_vehicle_count": 5,
    "spawn_probability": 0.1,
    "policy_frequency": 5,
    "collision_reward": -20,
    "high_speed_reward": 1,
    "arrived_reward": 20,
    "reward_speed_range": [7.0, 9.0],
    "normalize_reward": false
  },
  "idm": {
    "comfort_acc_max": 1.0,
    "comfort_acc_min": -10.0,
    "distance_wanted": 20.0,
    "time_wanted": 5
  }
}
