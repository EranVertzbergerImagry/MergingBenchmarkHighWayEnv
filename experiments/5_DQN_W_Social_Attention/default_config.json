{
  "description": "default",
  "train_timesteps": 100000,
  "eval_freq": 5000,
  "eval_episodes": 20,
  "demo_episodes": 3,
  "demo_on_train_end": true,
  "model": {
    "learning_rate": 5e-4,
    "buffer_size": 15000,
    "learning_starts": 200,
    "batch_size": 64,
    "gamma": 0.95,
    "train_freq": 1,
    "target_update_interval": 512,
    "exploration_fraction": 0.3,
    "exploration_final_eps": 0.05
  },
  "env": {
    "observation": {
      "type": "Kinematics",
      "vehicles_count": 15,
      "features": ["presence", "x", "y", "vx", "vy", "cos_h", "sin_h"],
      "features_range": {"x": [-100, 100], "y": [-100, 100],
                          "vx": [-20, 20], "vy": [-20, 20]},
      "absolute": true,
      "flatten": false,
      "order": "shuffled"
    },
    "action": {
      "type": "DiscreteMetaAction",
      "target_speeds": [0, 2, 5, 10, 15, 20]
    },
    "duration": 100,
    "destination": "o1",
    "initial_vehicle_count": 5,
    "spawn_probability": 0.1,
    "policy_frequency": 5,
    "collision_reward": -5,
    "high_speed_reward": 0,
    "arrived_reward": 1,
    "reward_speed_range": [7.0, 9.0],
    "normalize_reward": false
  },
  "idm": {
    "comfort_acc_max": 1.0,
    "comfort_acc_min": -10.0,
    "distance_wanted": 20.0,
    "time_wanted": 5
  }
}
